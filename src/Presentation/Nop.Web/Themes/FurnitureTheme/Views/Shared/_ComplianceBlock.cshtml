@model ProductSpecificationModel
@*
    Conditional UK compliance content block (spec §2.3 & §4 — fire safety labelling for upholstered
    items "where applicable", plus general material/care/certification info). CONDITIONAL by design:
    it only renders when the product's own specification attributes indicate it's relevant, so it does
    NOT appear on every product (e.g. a bookcase or a rug with no fire-safety attributes shows nothing).

    Detection is data-driven off the existing ProductSpecificationModel — we scan spec attribute names
    AND their values for fire-safety / upholstery keywords (incl. the UK standard BS 7177 / Crib 5).
    Merchants control visibility purely by which spec attributes they attach to a product; no code or
    template change needed to opt a category in or out.
*@
@{
    var fireSafetyKeywords = new[]
    {
        "fire", "flammab", "ignition", "upholst", "crib 5", "crib5",
        "bs 7177", "bs7177", "bs 5852", "bs5852", "fire safety", "fire retardant", "flame retardant"
    };

    var allAttributes = Model.Groups.SelectMany(g => g.Attributes).ToList();

    //match on the attribute name OR any of its rendered values
    bool Matches(ProductSpecificationAttributeModel a)
    {
        if (!string.IsNullOrEmpty(a.Name) &&
            fireSafetyKeywords.Any(k => a.Name.Contains(k, StringComparison.OrdinalIgnoreCase)))
            return true;

        return a.Values.Any(v => !string.IsNullOrEmpty(v.ValueRaw) &&
            fireSafetyKeywords.Any(k => v.ValueRaw.Contains(k, StringComparison.OrdinalIgnoreCase)));
    }

    var fireSafetyRows = allAttributes.Where(Matches).ToList();
    var showFireSafety = fireSafetyRows.Any();
}
@if (showFireSafety)
{
    <section class="ft-compliance" aria-labelledby="ft-compliance-title">
        <div class="ft-compliance__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2s5 4 5 9a5 5 0 01-10 0c0-2 1-3 1-3s0 2 2 2c1.5 0 1-3 1-5 0-2 1-4 1-4z" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 20h6" stroke-linecap="round"/>
            </svg>
        </div>
        <div class="ft-compliance__content">
            <h2 class="ft-compliance__title" id="ft-compliance-title">Fire safety &amp; compliance</h2>
            <p class="ft-compliance__intro">
                This item meets UK fire safety labelling requirements for upholstered furniture.
                The following certification details are recorded for this product:
            </p>
            <ul class="ft-compliance__list">
                @foreach (var attr in fireSafetyRows)
                {
                    <li>
                        <span class="ft-compliance__label">@attr.Name:</span>
                        <span class="ft-compliance__value">
                            @for (var j = 0; j < attr.Values.Count; j++)
                            {
                                @Html.Raw(attr.Values[j].ValueRaw)
                                @if (j != attr.Values.Count - 1)
                                {
                                    <text>,&nbsp;</text>
                                }
                            }
                        </span>
                    </li>
                }
            </ul>
            <p class="ft-compliance__note">
                The permanent fire safety label is attached to the product on delivery, as required by the
                Furniture and Furnishings (Fire) (Safety) Regulations 1988.
                <span class="ft-placeholder-tag">[compliance copy placeholder &mdash; confirm final wording with legal]</span>
            </p>
        </div>
    </section>
}
